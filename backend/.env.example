PORT=5000
# MONGO_URI khali chhodo = built-in database (kuch install nahi karna).
# Apna MongoDB / Atlas use karna ho to e.g. mongodb://127.0.0.1:27017/shopping_centre
MONGO_URI=
JWT_SECRET=change_this_to_a_long_random_string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Sirf tab chahiye jab frontend alag jagah host ho (comma se multiple)
# CLIENT_ORIGIN=http://localhost:5173
